pkgname=jarvis
pkgver=0.1.0
pkgrel=1
pkgdesc='Holographic JARVIS-styled desktop companion connected to Antigravity with offline British TTS'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/jarvis "$pkgdir/usr/bin/jarvis"
  install -Dm755 scripts/jarvis-hook "$pkgdir/usr/bin/jarvis-hook"
  install -Dm755 scripts/tts_worker.py "$pkgdir/usr/share/jarvis/tts_worker.py"
  install -Dm755 scripts/mic_worker.py "$pkgdir/usr/share/jarvis/mic_worker.py"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/jarvis.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/jarvis.svg"
  install -Dm644 "$startdir/jarvis.desktop" "$pkgdir/usr/share/applications/jarvis.desktop"
}
