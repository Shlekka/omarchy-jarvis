#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

find_binary() {
  if [[ -x "$HOME/.local/bin/jarvis" ]]; then
    printf '%s\n' "$HOME/.local/bin/jarvis"
    return 0
  fi
  if command -v jarvis >/dev/null 2>&1; then
    command -v jarvis
    return 0
  fi
  if [[ -x "$ROOT/build/jarvis" ]]; then
    printf '%s\n' "$ROOT/build/jarvis"
    return 0
  fi
  return 1
}

is_running() {
  pgrep -x jarvis >/dev/null 2>&1
}

cmd_status() {
  local installed="false"
  local running="false"
  if find_binary >/dev/null 2>&1; then
    installed="true"
  fi
  if is_running; then
    running="true"
  fi
  printf '{"installed":%s,"running":%s}\n' "$installed" "$running"
}

cmd_setup() {
  local setup_script="$ROOT/bin/setup"
  local quoted
  printf -v quoted '%q --launch' "$setup_script"
  if command -v omarchy-launch-floating-terminal-with-presentation >/dev/null 2>&1; then
    setsid -f omarchy-launch-floating-terminal-with-presentation "bash $quoted" >/dev/null 2>&1 < /dev/null
  elif command -v xdg-terminal-exec >/dev/null 2>&1; then
    setsid -f xdg-terminal-exec -e bash -lc "bash $quoted; echo; read -rp 'Press Enter to close...'" >/dev/null 2>&1 < /dev/null
  else
    exec bash "$setup_script" --launch
  fi
}

cmd_start() {
  if is_running; then
    return 0
  fi
  local bin
  if ! bin="$(find_binary)"; then
    cmd_setup
    return 0
  fi
  setsid -f "$bin" >/dev/null 2>&1 < /dev/null
}

cmd_stop() {
  pkill -x jarvis 2>/dev/null || true
}

cmd_toggle() {
  if is_running; then
    cmd_stop
  else
    cmd_start
  fi
}

case "${1:-status}" in
  status) cmd_status ;;
  start|launch) cmd_start ;;
  stop) cmd_stop ;;
  toggle) cmd_toggle ;;
  setup) cmd_setup ;;
  *)
    echo "Usage: $(basename "$0") {status|start|stop|toggle|setup}" >&2
    exit 2
    ;;
esac
