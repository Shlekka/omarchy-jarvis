#!/usr/bin/env python3
"""Antigravity lifecycle hook bridge for the J.A.R.V.I.S. desktop companion.

Reads the Antigravity hook JSON payload from stdin, forwards a compact summary
to the running JARVIS Unix socket with a strict short timeout so it never
blocks Antigravity, and prints a valid empty JSON object to stdout.
"""

from __future__ import annotations

import json
import os
import socket
import sys
from pathlib import Path

SOCKET_PATH = Path.home() / ".local" / "share" / "jarvis" / "jarvis.sock"


def main() -> int:
    raw = sys.stdin.read()

    # Do not echo hooks generated by JARVIS's own interactive agy subprocesses.
    if os.environ.get("JARVIS_INTERNAL_SESSION") == "1":
        sys.stdout.write("{}\n")
        return 0

    try:
        payload = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError:
        payload = {}

    tool_call = payload.get("toolCall") if isinstance(payload.get("toolCall"), dict) else {}
    msg = {
        "hookEventName": payload.get("hookEventName", ""),
        "conversationId": payload.get("conversationId", ""),
        "toolName": tool_call.get("name", ""),
        "error": payload.get("error", ""),
        "terminationReason": payload.get("terminationReason", ""),
        "cwd": payload.get("cwd", ""),
        "lastUserInput": str(payload.get("lastUserInput", ""))[:160],
    }

    if SOCKET_PATH.exists():
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
                sock.settimeout(0.15)
                sock.connect(str(SOCKET_PATH))
                sock.sendall((json.dumps(msg) + "\n").encode("utf-8"))
        except OSError:
            pass

    sys.stdout.write("{}\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
